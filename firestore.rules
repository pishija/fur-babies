rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read and write only their own subtree
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Matches are readable by both participants, writable by either
    match /matches/{matchId} {
      allow read, write: if request.auth != null
        && request.auth.uid in resource.data.participantIds;
    }

    match /matches/{matchId}/messages/{msgId} {
      allow read, write: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.participantIds;
    }

    // Swipes are write-only by the swiper (no reading other users' swipes)
    match /swipes/{swipeId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.swiperId;
      allow read: if false;
    }

    // Block records — only the blocker can create/delete
    match /blocks/{blockId} {
      allow create, delete: if request.auth != null
        && request.auth.uid == resource.data.blockerId;
      allow read: if request.auth != null
        && request.auth.uid in [resource.data.blockerId, resource.data.blockedId];
    }

    // Places — public read, no user writes (team-curated)
    match /places/{placeId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /reviews/{reviewId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.authorId;
        allow update, delete: if request.auth != null
          && request.auth.uid == resource.data.authorId;
      }
    }

    // Place suggestions — authenticated users can submit, not read others'
    match /placeSuggestions/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Place reports — same pattern
    match /placeReports/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Events — public read, auth users can RSVP
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /rsvps/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Event reports
    match /eventReports/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Exhibitions — public read, no user writes
    match /exhibitions/{exhibitionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Badge definitions — public read
    match /badges/{badgeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
